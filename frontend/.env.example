# Copy this file to .env.local and fill in the values. Never commit real keys.

# Public site URL used for sitemap.xml, robots.txt and OG image (set after deploy, e.g. https://agentdesk.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Neon Postgres. Use the "Pooled connection" string from your Neon dashboard
# (format: postgresql://...@ep-xxx-pooler...neon.tech/neondb?sslmode=require).
# Without this the marketplace is empty and hires are held in memory until restart.
DATABASE_URL=

# Optional 8004scan API key. Anonymous semantic search currently works.
AGENTSCAN_API_KEY=

# Optional custom BSC testnet RPC used for server-side receipt and Keystore verification.
BSC_TESTNET_RPC_URL=

# Protects the Vercel registry sync cron route.
CRON_SECRET=
