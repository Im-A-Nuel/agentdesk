{
  "name": "agentdesk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "db:seed": "npm run db:migrate && npm run sync:agents",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.ts",
    "sync:agents": "node --env-file=.env.local scripts/sync-agents.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3"
  }
}
